<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Bewusst schlank: formale Hygiene, keine Stilkriege. Bei Bedarf schrittweise erweitern. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>

  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="Zeile endet mit Leerzeichen."/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="^.{121,}$"/>
    <property name="message" value="Zeile ist länger als 120 Zeichen."/>
  </module>

  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="NeedBraces"/>
    <module name="EmptyBlock"/>
    <module name="EqualsHashCode"/>
    <module name="ModifierOrder"/>
    <module name="OneTopLevelClass"/>
    <module name="UpperEll"/>

    <!-- Code-Standards (config/standards/code.md, Issue #207) -->
    <!-- CODE-2: Einheiten klein. Leerzeilen und Kommentare zählen nicht mit. -->
    <module name="MethodLength">
      <property name="max" value="40"/>
      <property name="countEmpty" value="false"/>
    </module>
    <!-- CODE-4: Fehler sichtbar. Ein leerer catch ist nur mit Kommentar erlaubt, der das Warum erklärt (CODE-8). -->
    <module name="EmptyCatchBlock"/>
    <!-- CODE-8: Kommentar erklärt Warum. Ein TODO oder FIXME nennt sein Issue (#<nr>). -->
    <module name="TodoComment">
      <property name="format" value="\b(TODO|FIXME)\b(?!.*#[0-9]+)"/>
    </module>
  </module>
</module>
